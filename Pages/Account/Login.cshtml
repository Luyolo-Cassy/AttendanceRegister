@page
@model AttendanceRegister.Pages.Account.LoginModel
@{ ViewData["Title"] = "Log in"; }

<h1>Log in</h1>
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Log in</button>
            <a asp-page="/Account/Register" class="btn btn-link">Need an account? Register</a>
        </form>

        <hr />
        <p class="text-muted">Demo lecturer login: <code>lecturer@uct.ac.za</code> / <code>ChangeMe123!</code></p>
        <p class="text-muted">Demo Student login: <code>stdnum001@student.uct.ac.za</code> / <code>Student@2026!</code> The password is universal for all students</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
