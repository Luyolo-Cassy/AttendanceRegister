@page
@model AttendanceRegister.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Register"; }

<h1>Register</h1>
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="form-control" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Role" class="form-label">I am a</label>
                <select asp-for="Input.Role" class="form-select">
                    <option value="Student">Student</option>
                    <option value="Lecturer">Lecturer</option>
                </select>
            </div>

            <div class="mb-3" id="studentNumberGroup">
                <label asp-for="Input.StudentNumber" class="form-label"></label>
                <input asp-for="Input.StudentNumber" class="form-control" />
                <span asp-validation-for="Input.StudentNumber" class="text-danger"></span>
                <div class="form-text">Required for students, e.g. STDNUM001</div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Purely a UX nicety: hide the student number field for lecturers so the form
        // doesn't look like it's asking a lecturer for a student number. Server-side
        // validation in RegisterModel is what actually enforces the rule.
        const roleSelect = document.querySelector('#Input_Role');
        const studentGroup = document.querySelector('#studentNumberGroup');
        function toggle() { studentGroup.style.display = roleSelect.value === 'Student' ? '' : 'none'; }
        roleSelect.addEventListener('change', toggle);
        toggle();
    </script>
}
