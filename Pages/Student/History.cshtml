@page
@model AttendanceRegister.Pages.Student.HistoryModel
@{ ViewData["Title"] = "Attendance History"; }

<h1>Attendance History</h1>

<table class="table table-striped">
    <thead>
        <tr><th>Date</th><th>Lecture</th><th>Status</th><th>Recorded by</th></tr>
    </thead>
    <tbody>
    @foreach (var record in Model.Records)
    {
        <tr>
            <td>@record.Lecture?.Date</td>
            <td>@record.Lecture?.Title</td>
            <td><span class="badge bg-@Model.BadgeColor(record.Status)">@record.Status</span></td>
            <td>@record.RecordedBy</td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Records.Any())
{
    <p class="text-muted">No attendance records yet.</p>
}
